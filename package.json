{
    "name": "avto-yordam",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "pnpm": ">=10.15.0"
    },
    "packageManager": "pnpm@11.5.2",
    "scripts": {
        "bootstrap": "pnpm install",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test_unit": "vitest",
        "test_e2e": "playwright test",
        "check": "ultracite check",
        "fix": "ultracite fix",
        "typecheck": "vue-tsc --build",
        "verify": "pnpm run check && pnpm run typecheck && pnpm run build",
        "clean_dist": "rimraf dist",
        "clean_node": "rimraf node_modules",
        "clean_all": "pnpm run clean_dist && pnpm run clean_node"
    },
    "dependencies": {
        "lucide-vue-next": "^1.0.0",
        "pinia": "~3.0.4",
        "vue": "~3.5.35",
        "vue-router": "~5.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@playwright/test": "^1.59.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^29.0.2",
        "npm-run-all2": "^8.0.4",
        "rimraf": "^6.1.3",
        "typescript": "~6.0.0",
        "ultracite": "7.8.2",
        "vite": "^8.0.8",
